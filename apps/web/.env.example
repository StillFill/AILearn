# Obrigatório (P2): PostgreSQL e segredo para sessões NextAuth.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
AUTH_SECRET="gere-uma-string-longa-aleatoria-ex-openssl-rand-base64-32"

# Opcional: habilita respostas reais via OpenAI no BFF (nunca expor no browser).
OPENAI_API_KEY=
# Modelo de chat quando OPENAI_API_KEY está definida (padrão: gpt-4o-mini).
OPENAI_CHAT_MODEL=gpt-4o-mini

# TTS OpenAI (opcional). Por omissão false: o chat usa só Web Speech no browser.
# Quando true E OPENAI_API_KEY definida: POST /api/v1/tts devolve MP3 (voz melhor; custo OpenAI).
OPENAI_TTS_ENABLED=false
# OPENAI_TTS_MODEL=tts-1
# Voz: alloy | echo | fable | onyx | nova | shimmer (padrão: nova)
# OPENAI_TTS_VOICE=nova
# Máx. pedidos TTS por utilizador por minuto (padrão: 30)
# RATE_LIMIT_TTS_PER_MIN=30

# Rate limit (memória por instância; opcional — têm defaults no código)
# Máx. mensagens de chat por utilizador por minuto (default 40)
# RATE_LIMIT_CHAT_MESSAGES_PER_MIN=40
# Máx. registos por IP por janela (default 10) e janela em ms (default 900000 = 15 min)
# RATE_LIMIT_REGISTER_PER_WINDOW=10
# RATE_LIMIT_REGISTER_WINDOW_MS=900000
