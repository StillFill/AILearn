generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProfileRole {
  STUDENT
  GUARDIAN
}

model User {
  id              String      @id @default(cuid())
  email           String      @unique
  passwordHash    String
  name            String
  role            ProfileRole
  termsAcceptedAt DateTime
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}
